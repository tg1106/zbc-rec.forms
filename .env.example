# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in every value before running.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# Node environment
NODE_ENV=development

# Port the Express server listens on
PORT=3000

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING_AT_LEAST_48_CHARS

# Google Apps Script Web App URL (deploy google-sheet-sync.gs as a Web App and paste the URL)
GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# API tokens — must match the values in google-sheet-sync.gs
# Generate at: https://randomkeygen.com  (Fort Knox Passwords section)
GAS_SUBMIT_TOKEN=CHANGE_ME_SUBMIT_TOKEN_MIN_32_CHARS
GAS_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN_MIN_32_CHARS

# Admin dashboard password (plain text here — hashed on the server, never sent to browser)
ADMIN_PASSWORD=Zbcftw
